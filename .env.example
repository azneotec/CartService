# Copy to .env and fill in. .env is gitignored; the Makefile loads it for `make run`.
# Port 27018 is the MongoDB from `make infra-up`; use 27017 for the root stack's MongoDB
# (`make infra-up` in the repo root) or for a MongoDB installed on the host.
MONGODB_URI='mongodb://root:password@localhost:27018/cart_service?authSource=admin'
# Redis for the cart cache: 6380 is the standalone Redis from `make infra-up`; the root stack's is 6379.
REDIS_PORT='6380'
# Register with Eureka on http://localhost:8761 as cart-service. Token validation, product lookup and
# order placement all resolve Eureka names, so with 'false' the app starts but cannot serve /cart requests.
# Start Eureka first (the root `make eureka`), or set 'false' only for work that needs no downstream calls.
EUREKA_CLIENT_ENABLED='true'
# Optional. The app listens on 8003 by default; set 9003 to run a second instance beside it.
# Anything set here overrides that default, so leave it unset for the normal single-instance run.
# SERVER_PORT='9003'
