meta {
  name: Get Empty Cart
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.totalQuantity: eq 0
}

tests {
  test("empty cart has no items and a zero total", function () {
    expect(res.body.items).to.be.an("array").that.is.empty;
    expect(Number(res.body.total)).to.equal(0);
  });
}

docs {
  A user with no cart document gets an empty cart, not a 404.
}
