meta {
  name: Checkout - Empty Cart
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/cart/checkout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "deliveryAddress": {
      "fullName": "Asha Verma",
      "phoneNumber": "+91 98765 43210",
      "addressLine1": "42, Lakeview Apartments, MG Road",
      "addressLine2": "Near City Mall",
      "city": "Bengaluru",
      "state": "Karnataka",
      "postalCode": "560001",
      "country": "India"
    },
    "paymentMethod": "COD"
  }
}

script:pre-request {
  // An empty cart cannot be checked out.
  await bru.runRequest("Cart/Clear Cart");
}

assert {
  res.status: eq 409
  res.body.message: eq Your cart is empty
}
