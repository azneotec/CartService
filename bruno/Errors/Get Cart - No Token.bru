meta {
  name: Get Cart - No Token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

tests {
  test("error body has the standard shape", function () {
    expect(res.body.status).to.equal(401);
    expect(res.body.message).to.be.a("string");
  });
}
