meta {
  name: Cart After Confirm
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.totalQuantity: eq 0
}

docs {
  After a successful Confirm Order the ordered lines are removed, so the cart is empty.
}
