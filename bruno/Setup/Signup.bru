meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "phoneNumber": "{{userPhone}}"
  }
}

script:pre-request {
  // Email and phone are unique per user, so mint a fresh pair on every run.
  const stamp = Date.now();
  bru.setVar("userEmail", `bruno.cart.${stamp}@example.com`);
  bru.setVar("userPhone", `+65${String(stamp).slice(-8)}`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("userId", res.body.id);
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates a throwaway ROLE_USER account on user-auth-service (`authUrl`). Run the Setup folder
  first: every cart request needs the token that Login stores.
}
